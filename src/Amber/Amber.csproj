<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\amber.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Tray icons are loaded from files next to the exe. -->
    <None Update="Assets\*.ico" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Licenses.txt" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets\Fonts\*.ttf" />
    <Resource Include="Assets\Heroes\*.png" />
    <Resource Include="Assets\resize.cur" />
  </ItemGroup>

</Project>
