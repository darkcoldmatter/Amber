<UserControl x:Class="Amber.Controls.TimeSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Orientation="Horizontal">
        <ComboBox x:Name="ClockBox" Style="{StaticResource TimeBox}" Width="95" SelectionChanged="OnSelectionChanged" />
        <ComboBox x:Name="PeriodBox" Style="{StaticResource TimeBox}" Width="72" Margin="5,0,0,0" SelectionChanged="OnSelectionChanged" />
    </StackPanel>
</UserControl>
