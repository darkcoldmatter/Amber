<Window x:Class="Amber.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Amber" Width="360" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">
    <!-- Temporary test screen for the color engine. Replaced by the Figma design in step 3. -->
    <StackPanel Margin="24">
        <CheckBox Content="On" IsChecked="{Binding IsOn}" />

        <TextBlock Text="Mode" Margin="0,20,0,6" FontWeight="SemiBold" />
        <RadioButton x:Name="GoldenHourOption" Content="Golden hour" Checked="OnModeChecked" />
        <RadioButton x:Name="AmberOption" Content="Amber" Margin="0,4,0,0" Checked="OnModeChecked" />
        <RadioButton x:Name="AstronomicOption" Content="Astronomic" Margin="0,4,0,0" Checked="OnModeChecked" />

        <DockPanel Margin="0,20,0,6">
            <TextBlock DockPanel.Dock="Right" Text="{Binding Level, StringFormat=N0}" />
            <TextBlock Text="Level" FontWeight="SemiBold" />
        </DockPanel>
        <Slider Minimum="0" Maximum="100" IsMoveToPointEnabled="True" Value="{Binding Level}" />
    </StackPanel>
</Window>
