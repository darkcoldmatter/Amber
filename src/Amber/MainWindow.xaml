<Window x:Class="Amber.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Amber.Controls"
        Title="Amber" SizeToContent="WidthAndHeight" MaxHeight="800" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}" FontFamily="{StaticResource AppFont}" UseLayoutRounding="True"
        TextOptions.TextRenderingMode="Grayscale">
    <!--
        The content sets the window's size: 724 wide in Simple, 848 in Advanced (Figma frames = client area).
        The text look is app-wide (TextLook); a window only passes its grey smoothing on when it is set on the window.
    -->
    <Grid x:Name="Root" Width="724">
        <controls:Glow x:Name="Glow" IsHitTestVisible="False" />
        <!-- Lights up as a wave when the tint is switched on or off; empty otherwise (DotWave.cs). -->
        <controls:DotWaveLayer x:Name="Wave" />

        <Grid x:Name="ModeLayer">
            <Grid.RowDefinitions>
                <RowDefinition Height="66" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header, shared by both modes -->
            <Canvas>
                <Button Canvas.Left="23" Canvas.Top="15" Style="{StaticResource IconButton}" Tag="{StaticResource IconGear}"
                        Foreground="{StaticResource InkBrush}" Click="OnOpenSettings" AutomationProperties.Name="Settings" />
                <Button Canvas.Left="67" Canvas.Top="15" Style="{StaticResource IconButton}" Tag="{StaticResource IconInfo}"
                        Foreground="{StaticResource InkBrush}" Click="OnOpenAbout" AutomationProperties.Name="About" />
                <ToggleButton Canvas.Left="127" Canvas.Top="23" Style="{StaticResource Switch}" Content="Advanced"
                              IsChecked="{Binding IsAdvanced}" AutomationProperties.Name="Advanced" />
                <ToggleButton x:Name="ScheduleButton" Canvas.Left="460" Canvas.Top="12" Style="{StaticResource ScheduleButton}"
                              IsChecked="{Binding ScheduleEnabled}" AutomationProperties.Name="Schedule" />
                <ToggleButton x:Name="PowerButton" Canvas.Right="24" Canvas.Top="15" Style="{StaticResource PowerButton}"
                              AutomationProperties.Name="Tint on or off" />
            </Canvas>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                <ContentControl x:Name="ModeHost" Focusable="False" />
            </ScrollViewer>
        </Grid>

        <ContentControl x:Name="OverlayHost" Visibility="Collapsed" Focusable="False" />

        <!-- "New in this version", over everything else, header included (WhatsNewView). -->
        <ContentControl x:Name="NotesHost" Visibility="Collapsed" Focusable="False" />
    </Grid>
</Window>
