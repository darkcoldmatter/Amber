<Window x:Class="Amber.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Amber" Width="690" SizeToContent="Height" MaxHeight="800" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="White" FontFamily="{StaticResource AppFont}" UseLayoutRounding="True">
    <Grid>
        <Grid x:Name="ModeLayer">
            <Grid.RowDefinitions>
                <RowDefinition Height="67" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Canvas>
                <Canvas Canvas.Left="30" Canvas.Top="20" Width="116" Height="25">
                    <Path Data="{StaticResource LogoSun}" Fill="{StaticResource LogoSunBrush}" />
                    <Path Data="{StaticResource LogoWord}" Fill="{StaticResource InkBrush}" />
                </Canvas>
                <Button x:Name="AppModeButton" Canvas.Left="462" Canvas.Top="14" Width="106" Style="{StaticResource PillButton}"
                        Content="Advanced" Click="OnSwitchAppMode" />
                <Button Canvas.Left="584" Canvas.Top="15" Style="{StaticResource IconButton}" Tag="{StaticResource IconGear}"
                        Click="OnOpenSettings" AutomationProperties.Name="Settings" />
                <Button Canvas.Left="624" Canvas.Top="15" Style="{StaticResource IconButton}" Tag="{StaticResource IconInfo}"
                        Click="OnOpenAbout" AutomationProperties.Name="About" />
            </Canvas>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ContentControl x:Name="ModeHost" />
            </ScrollViewer>
        </Grid>

        <ContentControl x:Name="OverlayHost" Background="White" Visibility="Collapsed" />
    </Grid>
</Window>
