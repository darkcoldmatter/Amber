<UserControl x:Class="Amber.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel Margin="0,31,0,0">
            <TextBlock Text="About" Style="{StaticResource PageTitle}" />
            <Rectangle Style="{StaticResource Divider}" Margin="0,19,0,0" />
            <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" LineHeight="20" Margin="0,20,0,0"
                       Text="Blue light from screens can disrupt your circadian rhythm and strain your eyes. Amber cuts down the blue light your screen gives off." />
            <Button Style="{StaticResource PrimaryButton}" Width="150" HorizontalAlignment="Left" Margin="0,22,0,0" Click="OnGitHubClick">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconGitHub}" Fill="White" Width="16" Height="16" VerticalAlignment="Center" />
                    <TextBlock Text="GitHub" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>

        <Grid VerticalAlignment="Bottom" Margin="0,0,0,36">
            <TextBlock Style="{StaticResource CaptionText}">
                <Run Text="Version:" /> <Run x:Name="VersionRun" />
            </TextBlock>
            <TextBlock Style="{StaticResource CaptionText}" Margin="103,0,0,0" Text="Credit: Dmitriy Ratushniak" />
            <TextBlock Style="{StaticResource CaptionText}" HorizontalAlignment="Right">
                <Hyperlink Style="{StaticResource CaptionLink}" Click="OnLicensesClick">Licenses</Hyperlink>
            </TextBlock>
        </Grid>
    </Grid>
</UserControl>
