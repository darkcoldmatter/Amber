<UserControl x:Class="Amber.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="0,31,0,0">
        <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />
        <Rectangle Style="{StaticResource Divider}" Margin="0,19,0,0" />

        <DockPanel Height="36" Margin="0,16,0,0">
            <ToggleButton x:Name="StartWithWindowsSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="OnStartWithWindowsClick" AutomationProperties.Name="Start with Windows" />
            <TextBlock Text="Start with Windows" Style="{StaticResource LabelText}" />
        </DockPanel>
        <Rectangle Style="{StaticResource Divider}" Margin="0,16,0,0" />

        <DockPanel Height="36" Margin="0,16,0,0">
            <!-- Update checking comes in a later step. -->
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Width="100" Content="Check" />
            <TextBlock Text="Check for updates" Style="{StaticResource LabelText}" />
        </DockPanel>
    </StackPanel>
</UserControl>
