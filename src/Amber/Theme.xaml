<!-- Colors, fonts, icons and control styles from the Figma file "Design 1.0" / "Components". -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Amber.Controls">

    <!-- Colors -->
    <SolidColorBrush x:Key="InkBrush" Color="#271F1F" />
    <SolidColorBrush x:Key="InkHoverBrush" Color="#382D2D" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="#565656" />
    <SolidColorBrush x:Key="MutedBrush" Color="#7B7D87" />
    <SolidColorBrush x:Key="FaintBrush" Color="#A5AABA" />
    <SolidColorBrush x:Key="LineBrush" Color="#D3D6DF" />
    <SolidColorBrush x:Key="LineHoverBrush" Color="#B6BCCD" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#F5F3EE" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FBE8B3" />
    <SolidColorBrush x:Key="HoverRingBrush" Color="#EFF1F5" />
    <SolidColorBrush x:Key="PowerOnBrush" Color="#FFCB77" />

    <LinearGradientBrush x:Key="GoldenHourBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#DFE2EB" Offset="0" />
        <GradientStop Color="#FEDA79" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AmberBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FE980E" Offset="0" />
        <GradientStop Color="#FFCB84" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AstronomicBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF011B" Offset="0" />
        <GradientStop Color="#FFBDC3" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PowerOffHoverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#DFE2EB" Offset="0" />
        <GradientStop Color="#FFDA9D" Offset="1" />
    </LinearGradientBrush>

    <FontFamily x:Key="AppFont">pack://application:,,,/Assets/Fonts/#Plus Jakarta Sans</FontFamily>

