<UserControl x:Class="Amber.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Figma 111:9888. Covers the whole window; the card stretches with the window's width. -->
    <Grid Height="352">
        <TextBlock Text="About" Style="{StaticResource ScreenTitle}" Margin="24,17,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
        <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconCross}" Margin="0,15,24,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                Click="OnClose" AutomationProperties.Name="Close" />

        <Border Style="{StaticResource Card}" Margin="24,90,24,0" Height="238" VerticalAlignment="Top">
            <Grid>
                <Image Source="{StaticResource IconScreenImage}" Width="37" Height="29" Margin="24,24,0,0"
                       HorizontalAlignment="Left" VerticalAlignment="Top" />
                <!-- One sentence per line, as in Figma -->
                <TextBlock Style="{StaticResource BodyText}" Margin="81,18,22,0" VerticalAlignment="Top" TextWrapping="Wrap"
                           LineHeight="20" LineStackingStrategy="BlockLineHeight">
                    <Run Text="Blue light from screens can disrupt your circadian rhythm and strain your eyes." /><LineBreak /><Run
                        Text="Amber reduces the blue light your screen gives off." />
                </TextBlock>

                <Rectangle Style="{StaticResource Divider}" Margin="0,76,0,0" />

                <TextBlock Text="Source code" Style="{StaticResource LabelText}" Margin="24,108.35,0,0" VerticalAlignment="Top" />
                <Button Style="{StaticResource PrimaryButton}" Width="150" Margin="0,101,24,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Click="OnGitHubClick" AutomationProperties.Name="GitHub">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconGitHub}" Fill="White" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock Text="GitHub" Margin="6,-1,0,1" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <TextBlock Style="{StaticResource CaptionText}" Margin="24,201.5,0,0" VerticalAlignment="Top">
                    <Run Text="Version:" /> <Run x:Name="VersionRun" />
                </TextBlock>
                <TextBlock Style="{StaticResource CaptionText}" Margin="0,201.5,24,0" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Hyperlink Style="{StaticResource CaptionLink}" Click="OnLicensesClick" AutomationProperties.Name="Licenses">Licenses</Hyperlink>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>
