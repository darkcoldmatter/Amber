<UserControl x:Class="Amber.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Canvas Width="690" Height="330" Background="White">
        <TextBlock Canvas.Left="30" Canvas.Top="20" Text="About" Style="{StaticResource ScreenTitle}" />
        <Button Canvas.Left="624" Canvas.Top="15" Style="{StaticResource IconButton}" Tag="{StaticResource IconCross}"
                Foreground="{StaticResource InkBrush}" Click="OnClose" AutomationProperties.Name="Close" />
        <Rectangle Canvas.Left="0" Canvas.Top="66" Width="690" Height="1" Fill="{StaticResource LineBrush}" Opacity="0.6" />

        <Border Canvas.Left="30" Canvas.Top="88" Width="40" Height="40" CornerRadius="10" Background="{StaticResource SurfaceBrush}">
            <Canvas Width="26" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Path Data="{StaticResource LogoSun}" Fill="{StaticResource LogoSunBrush}">
                    <Path.RenderTransform>
                        <ScaleTransform ScaleX="0.72" ScaleY="0.72" />
                    </Path.RenderTransform>
                </Path>
            </Canvas>
        </Border>
        <TextBlock Canvas.Left="90" Canvas.Top="88" Width="570" TextWrapping="Wrap" LineHeight="22" Style="{StaticResource BodyText}"
                   Text="Blue light from screens can disrupt your circadian rhythm and strain your eyes. Amber cuts down the blue light your screen gives off." />

        <Border Canvas.Left="30" Canvas.Top="150" Width="630" Height="64" CornerRadius="16" Background="{StaticResource SurfaceBrush}">
            <DockPanel Margin="24,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Width="150" Click="OnGitHubClick" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconGitHub}" Fill="White" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock Text="GitHub" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <TextBlock Text="App's repository" Style="{StaticResource LabelText}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <TextBlock Canvas.Left="30" Canvas.Top="292" Style="{StaticResource CaptionText}">
            <Run Text="Version:" /> <Run x:Name="VersionRun" />
        </TextBlock>
        <TextBlock Canvas.Left="140" Canvas.Top="292" Style="{StaticResource CaptionText}" Text="Credit: Dmitriy Ratushniak" />
        <TextBlock Canvas.Left="560" Canvas.Top="292" Width="100" TextAlignment="Right" Style="{StaticResource CaptionText}">
            <Hyperlink Style="{StaticResource CaptionLink}" Click="OnLicensesClick">Licenses</Hyperlink>
        </TextBlock>
    </Canvas>
</UserControl>
