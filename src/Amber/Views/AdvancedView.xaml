<UserControl x:Class="Amber.Views.AdvancedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Amber.Controls"
             xmlns:views="clr-namespace:Amber.Views">
    <!-- Figma "Advanced" (section 111:10246), below the 66 px header: subtract 66 from Figma's y. -->
    <StackPanel Width="848">
        <!--
            A new version: one row under the header, ending at x 824 like the ON/OFF button, 24 px above whatever comes
            next (as far as the header is from it), so everything below moves down by 54 px while it shows.
        -->
        <views:UpdateNotice x:Name="Notice" Margin="0,9,24,15" HorizontalAlignment="Right" />

        <!-- "How it works" (Figma 111:9513): shown while there are no filters, until it is closed. -->
        <Border x:Name="Intro" Margin="23,9,24,11" Height="105" Background="White" CornerRadius="14">
            <Grid>
                <Image Source="{StaticResource IconQuestionImage}" Width="24" Height="24" Margin="16,16,0,0"
                       HorizontalAlignment="Left" VerticalAlignment="Top" />
                <TextBlock Text="How it works" Style="{StaticResource LabelText}" Margin="48,17.35,0,0" VerticalAlignment="Top" />
                <TextBlock Style="{StaticResource BodyText}" Margin="16,50,19,0" VerticalAlignment="Top" TextWrapping="Wrap"
                           LineHeight="20" LineStackingStrategy="BlockLineHeight">
                    <Run Text="Advanced mode lets you schedule" /> <Bold Foreground="{StaticResource InkBrush}">more than one</Bold> <Run
                        Text="display filter and apply a" /> <Bold Foreground="{StaticResource InkBrush}">dynamic tint</Bold> <Run
                        Text="level. Click the “+” button below to add the first filter." />
                </TextBlock>
                <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconCross}" Foreground="{StaticResource InkBrush}"
                        Margin="0,2,2,0" HorizontalAlignment="Right" VerticalAlignment="Top" Click="OnCloseIntro"
                        AutomationProperties.Name="Close how it works" />
            </Grid>
        </Border>

        <controls:AdvancedTimeline x:Name="Timeline" Width="800" Height="112" Margin="0,9,0,0" AutomationProperties.Name="Filters" />

        <!-- Nothing selected: add a filter. Selected: its settings. -->
        <Button x:Name="AddButton" Style="{StaticResource AddFilterButton}" Content="Add filter" Margin="0,36,0,36" HorizontalAlignment="Center"
                Click="OnAddClick" AutomationProperties.Name="Add filter" />
        <views:FilterPanel x:Name="Panel" Margin="0,42,0,24" Visibility="Collapsed" />
    </StackPanel>
</UserControl>
