<UserControl x:Class="Amber.Views.FilterPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Amber.Controls">
    <!-- The selected filter, under the timeline: Figma 111:3891 from its row at y 229, and 111:4240 with the curve open. -->
    <StackPanel Width="848">
        <Canvas Height="42">
            <Button x:Name="ModeField" Canvas.Left="24" Style="{StaticResource ModeDropdown}" Click="OnModeClick" AutomationProperties.Name="Tint" />

            <!--
                From x 190 to Figma's x 776: the times, then the level slider from 40 px after them to x 700, and its number
                right-aligned at 776. The 12-hour clock's wider times leave a shorter slider.
            -->
            <Grid Canvas.Left="190" Width="586" Height="42">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <controls:TimeField x:Name="StartField" AutomationProperties.Name="Start time" />
                    <Rectangle Margin="8,20,8,0" VerticalAlignment="Top" Width="10" Height="1" Fill="{StaticResource InkBrush}" />
                    <controls:TimeField x:Name="EndField" AutomationProperties.Name="End time" />
                </StackPanel>

                <!-- Gives way to the curve while the curve is on. The number must never take the mouse: it sits beside the slider. -->
                <Grid x:Name="LevelGroup" Grid.Column="1">
                    <controls:LevelSlider x:Name="Level" Margin="40,0,76,0" Style="{StaticResource LevelSlider}"
                                          Value="{Binding Level}" AutomationProperties.Name="Level" />
                    <!-- Digits centred on Figma's y 249.5. -->
                    <controls:TrackedText x:Name="Percent" FontFamily="{StaticResource NumberFont}" FontSize="24" FontWeight="Medium" Tracking="-0.96"
                                          Foreground="{StaticResource InkBrush}" Margin="0,0,0,1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          IsHitTestVisible="False" />
                </Grid>
            </Grid>

            <ToggleButton x:Name="CurveToggle" Canvas.Left="788" Canvas.Top="3" Style="{StaticResource CurveButton}"
                          IsChecked="{Binding CurveEnabled}" AutomationProperties.Name="Curve" />
        </Canvas>

        <Border x:Name="GraphCard" Style="{StaticResource Card}" Width="800" Height="241" Margin="0,24,0,0" Visibility="Collapsed">
            <controls:CurveEditor x:Name="Curve" AutomationProperties.Name="Level curve" />
        </Border>
    </StackPanel>
</UserControl>
