<UserControl x:Class="Amber.Views.FilterPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Amber.Controls">
    <!-- The selected filter, under the timeline: Figma 111:3891 from its row at y 229, and 111:4240 with the curve open. -->
    <StackPanel Width="848">
        <Canvas Height="42">
            <Button x:Name="ModeField" Canvas.Left="24" Style="{StaticResource ModeDropdown}" Click="OnModeClick" AutomationProperties.Name="Mode" />

            <controls:TimeField x:Name="StartField" Canvas.Left="190" AutomationProperties.Name="Start time" />
            <Rectangle Canvas.Left="285" Canvas.Top="20" Width="10" Height="1" Fill="{StaticResource InkBrush}" />
            <controls:TimeField x:Name="EndField" Canvas.Left="303" AutomationProperties.Name="End time" />

            <!-- Gives way to the curve while the curve is on. The number must never take the mouse: it sits beside the slider. -->
            <Grid x:Name="LevelGroup" Width="848" Height="42">
                <controls:LevelSlider x:Name="Level" Width="270" Margin="430,0,0,0" HorizontalAlignment="Left" Style="{StaticResource LevelSlider}"
                                      Value="{Binding Level}" AutomationProperties.Name="Level" />
                <!-- Right-aligned to Figma's x 776, digits centred on its y 249.5. -->
                <controls:TrackedText x:Name="Percent" FontFamily="{StaticResource NumberFont}" FontSize="24" FontWeight="Medium" Tracking="-0.96"
                                      Foreground="{StaticResource InkBrush}" Margin="0,0,72,1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                      IsHitTestVisible="False" />
            </Grid>

            <ToggleButton x:Name="CurveToggle" Canvas.Left="788" Canvas.Top="3" Style="{StaticResource CurveButton}"
                          IsChecked="{Binding CurveEnabled}" AutomationProperties.Name="Curve" />
        </Canvas>

        <Border x:Name="GraphCard" Style="{StaticResource Card}" Width="800" Height="241" Margin="0,24,0,0" Visibility="Collapsed">
            <controls:CurveEditor x:Name="Curve" AutomationProperties.Name="Level curve" />
        </Border>
    </StackPanel>
</UserControl>
