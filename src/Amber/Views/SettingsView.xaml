<UserControl x:Class="Amber.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Canvas Width="690" Height="330" Background="White">
        <TextBlock Canvas.Left="30" Canvas.Top="20" Text="Settings" Style="{StaticResource ScreenTitle}" />
        <Button Canvas.Left="624" Canvas.Top="15" Style="{StaticResource IconButton}" Tag="{StaticResource IconCross}"
                Foreground="{StaticResource InkBrush}" Click="OnClose" AutomationProperties.Name="Close" />
        <Rectangle Canvas.Left="0" Canvas.Top="66" Width="690" Height="1" Fill="{StaticResource LineBrush}" Opacity="0.6" />

        <Border Canvas.Left="30" Canvas.Top="92" Width="630" Height="64" CornerRadius="16" Background="{StaticResource SurfaceBrush}">
            <DockPanel Margin="24,0">
                <ToggleButton x:Name="StartWithWindowsSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                              Click="OnStartWithWindowsClick" AutomationProperties.Name="Start with Windows" />
                <TextBlock Text="Start with Windows" Style="{StaticResource LabelText}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <Border Canvas.Left="30" Canvas.Top="170" Width="630" Height="64" CornerRadius="16" Background="{StaticResource SurfaceBrush}">
            <DockPanel Margin="24,0">
                <!-- Update checking comes in a later step. -->
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Width="100" Content="Check" VerticalAlignment="Center" />
                <TextBlock Text="Check for updates" Style="{StaticResource LabelText}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Canvas>
</UserControl>
