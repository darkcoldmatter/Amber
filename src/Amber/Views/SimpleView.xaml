<UserControl x:Class="Amber.Views.SimpleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Amber.Controls"
             xmlns:views="clr-namespace:Amber.Views">
    <!-- Figma "home" 94:1746 and "scheduled" 111:4498, below the 66 px header: subtract 66 from Figma's y. -->
    <Canvas x:Name="Root" Width="724" Height="286">

        <!-- The digits are centred on Figma's y 141.5. -->
        <Grid Width="724" Height="151">
            <controls:TrackedText x:Name="Percent" FontFamily="{StaticResource NumberFont}" FontSize="70" FontWeight="Medium" Tracking="-2.8"
                                  Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>

        <controls:LevelSlider x:Name="Level" Canvas.Left="162" Canvas.Top="133" Width="400" Style="{StaticResource LevelSlider}"
                              Value="{Binding Level}" AutomationProperties.Name="Level" />

        <!-- Custom only: its colour bar, 12 px under the level slider; everything below moves down to make room. -->
        <controls:HueBar x:Name="Hue" Canvas.Left="162" Canvas.Top="187" Width="400" Style="{StaticResource HueBar}"
                         Value="{Binding CustomHue}" AutomationProperties.Name="Color" />

        <!--
            Under each chip, while shortcuts are on, the keys that pick it ("Ctrl + Alt + 1"): 12 px ink at 50 %, 2 px under
            the chip, 16 px line. The labels reach 40 px past their chip on each side, so a wide label never moves the chips.
        -->
        <StackPanel x:Name="Chips" Canvas.Top="230" Width="724">
            <StackPanel.Resources>
                <Style x:Key="ChipKeys" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="FontWeight" Value="Medium" />
                    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                    <Setter Property="Opacity" Value="0.5" />
                    <Setter Property="TextAlignment" Value="Center" />
                    <Setter Property="LineHeight" Value="16" />
                    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
                    <Setter Property="Margin" Value="-40,2,-40,0" />
                    <Setter Property="IsHitTestVisible" Value="False" />
                </Style>
            </StackPanel.Resources>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <StackPanel>
                    <RadioButton x:Name="GoldenHourChip" Style="{StaticResource ModeChip}" Content="Golden hour" Checked="OnModeChecked"
                                 AutomationProperties.Name="Golden hour" />
                    <TextBlock x:Name="GoldenHourKeys" Style="{StaticResource ChipKeys}" />
                </StackPanel>
                <StackPanel Margin="16,0,0,0">
                    <RadioButton x:Name="AmberChip" Style="{StaticResource ModeChip}" Content="Amber" Checked="OnModeChecked"
                                 AutomationProperties.Name="Amber" />
                    <TextBlock x:Name="AmberKeys" Style="{StaticResource ChipKeys}" />
                </StackPanel>
                <StackPanel Margin="16,0,0,0">
                    <RadioButton x:Name="DeepNightChip" Style="{StaticResource ModeChip}" Content="Deep night" Checked="OnModeChecked"
                                 AutomationProperties.Name="Deep night" />
                    <TextBlock x:Name="DeepNightKeys" Style="{StaticResource ChipKeys}" />
                </StackPanel>
                <StackPanel Margin="16,0,0,0">
                    <RadioButton x:Name="CustomChip" Style="{StaticResource ModeChip}" Content="Custom" Checked="OnModeChecked"
                                 AutomationProperties.Name="Custom" />
                    <TextBlock x:Name="CustomKeys" Style="{StaticResource ChipKeys}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <Canvas x:Name="SchedulePanel" Canvas.Top="282" Width="724" Height="164">
            <controls:ScheduleBar Canvas.Left="24" Width="676" Height="74" Start="{Binding ScheduleStart}" End="{Binding ScheduleEnd}"
                                  AutomationProperties.Name="Schedule timeline" />

            <!-- The fields are wider on the 12-hour clock: the dash and the end time move along with them. -->
            <StackPanel Canvas.Left="24" Canvas.Top="98" Orientation="Horizontal">
                <controls:TimeField Value="{Binding ScheduleStart}" AutomationProperties.Name="Start time" />
                <Rectangle Margin="8,20,8,0" VerticalAlignment="Top" Width="10" Height="1" Fill="{StaticResource InkBrush}" Opacity="0.5" />
                <controls:TimeField Value="{Binding ScheduleEnd}" AutomationProperties.Name="End time" />
            </StackPanel>

            <TextBlock Canvas.Right="136" Canvas.Top="109.7" Text="Transition" FontSize="14" FontWeight="Medium" Foreground="{StaticResource InkBrush}" />
            <Button x:Name="Transition" Canvas.Left="613" Canvas.Top="98" Style="{StaticResource FieldButton}" Click="OnTransitionClick"
                    AutomationProperties.Name="Transition" />
        </Canvas>

        <!-- A new version, in the empty top right (Figma 125:456): the note's capitals at y 80, the buttons at 101, ending at x 700. -->
        <views:UpdateNotice x:Name="Notice" Canvas.Right="24" Canvas.Top="11" Stacked="True" />
    </Canvas>
</UserControl>
