<UserControl x:Class="Amber.Views.UpdateNotice"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
    <!--
        Figma "Update notifications" (125:292, frame 125:456): a note with an orange dot (125:579), then Update (125:550)
        and ✕ (125:576), 5 px apart. Stacked (Simple) puts the note above the buttons; otherwise they share one row.
    -->
    <Grid x:Name="Layout">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel x:Name="NoteLine" Orientation="Horizontal" HorizontalAlignment="Right">
            <!-- Centred on the note's capitals. -->
            <Ellipse Width="6" Height="6" Margin="0,5,8,0" VerticalAlignment="Top" Fill="{StaticResource AmberAccent}" />
            <TextBlock x:Name="Note" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Opacity="0.7" />
        </StackPanel>

        <StackPanel x:Name="Buttons" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="UpdateButton" Style="{StaticResource NoticeButton}" Width="90" Click="OnUpdateClick">
                <Grid>
                    <StackPanel x:Name="UpdateLabel" Orientation="Horizontal">
                        <Path Data="{StaticResource IconDownload16}" Stroke="{StaticResource InkBrush}" StrokeThickness="1.5"
                              Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock Text="Update" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <!-- While downloading: how far it has got, in place of the label. -->
                    <TextBlock x:Name="Progress" FontFamily="{StaticResource NumberFont}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="Collapsed" />
                </Grid>
            </Button>
            <Button x:Name="SkipButton" Style="{StaticResource NoticeIconButton}" Tag="{StaticResource IconCross16}" Margin="5,0,0,0"
                    Click="OnSkipClick" AutomationProperties.Name="Skip this version" />
        </StackPanel>
    </Grid>
</UserControl>
