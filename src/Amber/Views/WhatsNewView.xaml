<UserControl x:Class="Amber.Views.WhatsNewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             KeyboardNavigation.TabNavigation="Cycle">
    <!--
        Figma 132:4828 "Update notes". An amber scrim over the whole window (it takes every click, so nothing behind it
        can be used) and a white card centred on it. The card's height follows the list: every other spacing is fixed.
    -->
    <Grid>
        <Rectangle Fill="{StaticResource AmberAccent}" Opacity="0.4" />

        <Border Style="{StaticResource Card}" Width="350" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <!-- Capitals 24 px below the card's top, baseline at 36. -->
                <TextBlock Text="New in this version:" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"
                           Margin="24,19,0,0" />

                <!-- 21 px lines: the first line's capitals at 59, its baseline at 70. Text 281 px wide, after a 21 px indent. -->
                <ItemsControl x:Name="Bullets" Margin="24,14,24,0" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Path Fill="{StaticResource SecondaryBrush}">
                                    <Path.Data>
                                        <EllipseGeometry Center="10.4,13.2" RadiusX="2.55" RadiusY="2.55" />
                                    </Path.Data>
                                </Path>
                                <TextBlock Text="{Binding}" Style="{StaticResource BodyText}" Margin="21,0,0,0" TextWrapping="Wrap"
                                           LineHeight="21" LineStackingStrategy="BlockLineHeight" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Rectangle Style="{StaticResource Divider}" Margin="0,35,0,0" />

                <Button x:Name="CloseButton" Style="{StaticResource PrimaryButton}" Width="120" Margin="0,12,24,12"
                        HorizontalAlignment="Right" Click="OnClose" AutomationProperties.Name="Close">
                    <TextBlock Text="Close" Margin="0,-1,0,1" />
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
